# Dependencias de Node.js (si se instalan para herramientas de desarrollo)
node_modules/

# Archivos de entorno (valores reales, no se suben)
.env

# Archivos de log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Carpetas de configuración de editor (opcional, si no quieres compartir tu configuración de VS Code)
.vscode/
.idea/

# Archivos de cobertura de pruebas (si las hay)
coverage/

# Archivos de construcción (si usas algún empaquetador)
dist/
build/

# ============================================================
# DOCUMENTACIÓN GENERADA (JSDoc) - ¡NUEVO!
# ============================================================
docs/

# Archivos binarios e imágenes
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.svg
*.eot
*.woff
*.woff2
*.ttf
*.otf
*.webp

# Archivos de prueba
*.test.js
*.spec.js

# Archivos de documentación Markdown
CHANGELOG.md
CONTRIBUTING.md
DoD.md

# Archivos HTML (excepto los principales)
*.html
!index.html
!simulador.html

# Archivos de desarrollo y configuración
jest.config.js
package-lock.json